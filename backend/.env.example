# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_NAME=BolãoCopa
APP_ENV=local          # production em prod
APP_KEY=               # php artisan key:generate
APP_DEBUG=true         # false em prod
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ─── Banco de Dados ───────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres       # "postgres" no Docker, "localhost" fora
DB_PORT=5432
DB_DATABASE=bolao
DB_USERNAME=bolao
DB_PASSWORD=           # ⚠️ Nunca alterar após o 1º deploy em produção

# Testes (php artisan test) usam backend/.env.testing → banco bolao_test separado.
# Criar uma vez: docker compose exec postgres psql -U bolao -d bolao -c "CREATE DATABASE bolao_test;"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis       # "redis" no Docker, "localhost" fora
REDIS_PORT=6379
REDIS_PASSWORD=null    # ⚠️ Nunca alterar após o 1º deploy em produção

# ─── Cache / Filas / Sessão ───────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── Sanctum ──────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000

# ─── Football Data API ────────────────────────────────────────────────────────
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITION=WC

# ─── Web Push (VAPID) — gerar com: php artisan webpush:vapid ─────────────────
# ⚠️ Nunca regenerar com usuários push ativos (invalida todas as assinaturas)
VAPID_SUBJECT=mailto:seu@email.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug        # error em prod

# ─── Manutenção ───────────────────────────────────────────────────────────────
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local
