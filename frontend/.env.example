# Alvo do proxy Vite para /api e /sanctum (dev apenas)
# Docker:     NUXT_PROXY_TARGET=http://nginx
# Standalone: NUXT_PROXY_TARGET=http://localhost:8000
NUXT_PROXY_TARGET=http://localhost:8000

# Chave pública VAPID para Web Push (mesmo valor de VAPID_PUBLIC_KEY no backend)
# Em produção este valor é embutido em build time via docker-compose.prod.yml args
NUXT_PUBLIC_VAPID_PUBLIC_KEY=

# URL da API (deixar vazio em prod — o nginx da SPA faz proxy de /api internamente)
NUXT_PUBLIC_API_URL=
